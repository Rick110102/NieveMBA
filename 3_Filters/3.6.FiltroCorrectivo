              // [44, "PERU"],
              // [45, "PERU"],
              // Regiones 46, 47 y 48 descartadas de las regiones de procesamiento final.
              // [46, "PERU"],
              // [47, "PERU"],
              // [48, "PERU"],
            ];
              

for(var rc = 0; rc < listrc.length; rc++){
  var param = { 
      regionGlacier: listrc[rc][0],
      pais: listrc[rc][1], 
      year: 2018,
      persistencia90: 100,
      version_input: 9,
      version_output: 10,
      voidThreshold: 1.30  // ← P90 > P35 * 1.30 → año vacío
  };
  
  print(param.regionGlacier);
  
  var dirinput = 'projects/mapbiomas-peru/assets/LAND-COVER/COLLECTION4/GLACIER-WET/classification-ft-v2';
  var persistence90 = 'projects/mapbiomas-peru/assets/LAND-COVER/COLLECTION4/GLACIER-WET/persistencia90';
  var dirout   = 'projects/mapbiomas-peru/assets/LAND-COVER/COLLECTION4/GLACIER-WET/classification-ft-v2/';
  
  var AssetRegions = 'projects/ee-mapbiomasaguaperu/assets/GlacierWetRegionesV2';
  
  var AssetRegionsRaster = ee.Image(0).paint(ee.FeatureCollection(AssetRegions), 1);
  
  var prefixo_out = param.pais + '-' + param.regionGlacier + '-' + param.version_output;
  
  var region = ee.FeatureCollection(AssetRegions)
               .filterMetadata('ord', 'equals', param.regionGlacier);
              
  var regionGeom = region.geometry();
  var regionRaster = AssetRegionsRaster.clip(regionGeom);
  
  var palettes = require('users/mapbiomas/modules:Palettes.js');
  var vis = {
      'min': 0,
      'max': 34,
      'palette': palettes.get('classification2')
  };

  // ── CARGAR CLASIFICACIÓN v9 (P35) ───────────────────────────
  var class9FT = ee.ImageCollection(dirinput)
                   .filterMetadata('code_region', 'equals', param.regionGlacier)
                   .filterMetadata('version', 'equals', param.version_input)
                   .first();
  print('Input v9 (P35):', class9FT);

  // ── CARGAR CAPA DE PERSISTENCIA 90% (v100) ──────────────────
  var persist90 = ee.ImageCollection(persistence90)
                    .filterMetadata('code_region', 'equals', param.regionGlacier)
                    .filterMetadata('version', 'equals', param.persistencia90)
                    .first();
  print('Input v100 (P90):', persist90);

  var years = [
      2000, 2001, 2002, 2003, 2004,
      2005, 2006, 2007, 2008, 2009,
      2010, 2011, 2012, 2013, 2014,
      2015, 2016, 2017, 2018, 2019,
      2020, 2021, 2022, 2023, 2024,
      2025
  ];    
      
  var bandNames = ee.List(
      years.map(function(year){
          return 'classification_' + String(year);
      })
  );

  // ── MÁSCARA P90 ──────────────────────────────────────────────
  // La capa de persistencia 90% es una sola imagen
  // La usamos como máscara del núcleo glaciar permanente
  var maskP90 = persist90.select('persistent_pixels').eq(1);

  // Contar píxeles totales de P90 en la región
  var countP90 = maskP90.reduceRegion({
      reducer: ee.Reducer.sum(),
      geometry: regionGeom,
      scale: 30,
      maxPixels: 1e9
  }).get('persistent_pixels');

  print('Total píxeles P90:', countP90);

  // ── CONTAR PÍXELES CLASE 34 EN ZONA P90 POR AÑO ─────────────
  // Construir imagen multiband con 1 donde hay clase 34 dentro de P90
  // Un solo reduceRegion para todos los años → evita el error
  var snowInP90 = ee.Image(0).select([]);

  years.forEach(function(year){
      var bandName = 'classification_' + year;
      var band = class9FT.select(bandName).eq(34)
                         .updateMask(maskP90)  // solo dentro de P90
                         .unmask(0)
                         .rename(bandName);
      snowInP90 = snowInP90.addBands(band);
  });

  // UN SOLO reduceRegion para todos los años
  var countsP35inP90 = snowInP90.reduceRegion({
      reducer: ee.Reducer.sum(),
      geometry: regionGeom,
      scale: 30,
      maxPixels: 1e9
  });

  print('Conteos P35 dentro de P90 por año:', countsP35inP90);

  // ── DETECTAR AÑOS VACÍOS EN EL CLIENTE ──────────────────────
  var countsInfo = countsP35inP90.getInfo();
  var countP90val = ee.Number(countP90).getInfo();

  print('Total píxeles P90 (valor):', countP90val);

  var voidYearsList = years.map(function(year){
      var bandName = 'classification_' + year;
      var countP35 = countsInfo[bandName] || 0;
      var isVoid = countP90val > countP35 * param.voidThreshold;
      print('Año ' + year + ' | P90: ' + countP90val + ' | P35: ' + countP35 + ' | Vacío: ' + isVoid);
      return isVoid;
  });

  // ── FUNCIÓN: BUSCAR AÑO VÁLIDO MÁS CERCANO ──────────────────
  var findValidYear = function(targetIdx, direction, voidList){
      var idx = targetIdx + direction;
      var result = -1;
      for(var i = 0; i < years.length; i++){
          if(idx < 0 || idx >= years.length) break;
          if(!voidList[idx]){
              result = idx;
              break;
          }
          idx += direction;
      }
      return result;
  };

  // ── APLICAR FILTRO CORRECTIVO ────────────────────────────────
  var imageCorrectivo = ee.Image(0).select([]);

  years.forEach(function(year, idx){
      var bandName = 'classification_' + year;
      var originalBand = class9FT.select(bandName);
      var isVoid = voidYearsList[idx];

      if(isVoid){
          print('⚠️ Año vacío detectado:', year);

          var prevIdx = findValidYear(idx, -1, voidYearsList);
          var nextIdx = findValidYear(idx, +1, voidYearsList);

          print('  Año anterior válido:', prevIdx >= 0 ? years[prevIdx] : 'ninguno');
          print('  Año posterior válido:', nextIdx >= 0 ? years[nextIdx] : 'ninguno');

          var fillBand;

          if(prevIdx >= 0 && nextIdx >= 0){
              // Intersección AND entre año anterior y posterior
              var prevBand = class9FT.select('classification_' + years[prevIdx]).eq(34);
              var nextBand = class9FT.select('classification_' + years[nextIdx]).eq(34);
              var intersection = prevBand.and(nextBand);

              fillBand = originalBand
                  .where(intersection.and(originalBand.neq(34)), 34)
                  .rename(bandName);

          } else if(prevIdx >= 0){
              var prevBand = class9FT.select('classification_' + years[prevIdx]).eq(34);
              fillBand = originalBand
                  .where(prevBand.and(originalBand.neq(34)), 34)
                  .rename(bandName);

          } else if(nextIdx >= 0){
              var nextBand = class9FT.select('classification_' + years[nextIdx]).eq(34);
              fillBand = originalBand
                  .where(nextBand.and(originalBand.neq(34)), 34)
                  .rename(bandName);

          } else {
              fillBand = originalBand.rename(bandName);
          }

          imageCorrectivo = imageCorrectivo.addBands(fillBand);

      } else {
          imageCorrectivo = imageCorrectivo.addBands(
              originalBand.rename(bandName)
          );
      }
  });

  // ── VISUALIZACIÓN ────────────────────────────────────────────

  Map.addLayer(maskP90.clip(regionGeom).selfMask(), {
      palette: 'blue'
  }, 'Persistencia 90% region-' + param.regionGlacier, false);

  Map.addLayer(class9FT, {
      bands: ['classification_' + param.year],
      min: 0, max: 34,
      palette: palettes.get('classification2')
  }, 'Original v9 (P35) - ' + param.year, false);

  Map.addLayer(imageCorrectivo, {
      bands: ['classification_' + param.year],
      min: 0, max: 34,
      palette: palettes.get('classification2')
  }, 'Correctivo v10 - ' + param.year, false);

  Map.addLayer(
      region.style({color: 'ff0000', fillColor: 'ff000000'}),
      {}, 'Region ' + param.regionGlacier, false
  );

  // ── EXPORTAR ─────────────────────────────────────────────────

  var imageExport = imageCorrectivo
      .select(bandNames)
      .set('code_region', param.regionGlacier)
      .set('pais', param.pais)
      .set('version', param.version_output)
      .set('descripcion', 'filtro-correctivo-wet')
      .set('paso', 'P07')
      .set('void_threshold', param.voidThreshold);

  Export.image.toAsset({
      image: imageExport.updateMask(regionRaster),
      description: prefixo_out,
      assetId: dirout + prefixo_out,
      pyramidingPolicy: {'.default': 'mode'},
      region: regionGeom.bounds(),
      scale: 30,
      maxPixels: 1e13
  });
}