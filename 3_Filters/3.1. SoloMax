// PROCESO DE MAX - GLACIER WET
// Por cada región se carga la clasificación, se aplica max por año
// y se construye imagen multiband para exportar

var listrc = [
              [1, "PERU"],
              // [2, "PERU"],
              // [3, "PERU"],
              // [4, "PERU"],
              // [5, "PERU"],
              // [6, "PERU"],
              // [7, "PERU"],
              // [8, "PERU"],
              // [9, "PERU"],
              // [10, "PERU"],
              // [11, "PERU"],
              // [12, "PERU"],
              // [13, "PERU"],
              // [14, "PERU"],
              // [15, "PERU"],
              // [16, "PERU"],
              // [17, "PERU"],
              // [18, "PERU"],
              // [19, "PERU"],
              // [20, "PERU"],
              // [21, "PERU"],
              // [22, "PERU"],
              // [23, "PERU"],
              // [24, "PERU"],
              // [25, "PERU"],
              // [26, "PERU"],
              // [27, "PERU"],
              // [28, "PERU"],
              // [29, "PERU"],
              // [30, "PERU"],
              // [31, "PERU"],
              // [32, "PERU"],
              // [33, "PERU"],
              // [34, "PERU"],
              // [35, "PERU"],
              // [36, "PERU"],
              // [37, "PERU"],
              // [38, "PERU"],
              // [39, "PERU"],
              // [40, "PERU"],
              // [41, "PERU"],
              // [42, "PERU"],
              // [43, "PERU"],
              // [44, "PERU"],
              // [45, "PERU"],
              // [46, "PERU"],
              // [47, "PERU"],
              // [48, "PERU"],
            ];

var years = [
    2000, 2001, 2002, 2003, 2004,
    2005, 2006, 2007, 2008, 2009,
    2010, 2011, 2012, 2013, 2014,
    2015, 2016, 2017, 2018, 2019,
    2020, 2021, 2022, 2023, 2024,
    2025
];

var AssetGlacierWetClass = 'projects/mapbiomas-peru/assets/LAND-COVER/COLLECTION4/GLACIER-WET/classification';
var Bounds = 'projects/ee-mapbiomasaguaperu/assets/RegionesGlaciaresWet';
var OutputAsset = 'projects/mapbiomas-peru/assets/LAND-COVER/COLLECTION4/GLACIER-WET/classification-ft/';

var param = {
    version_input: 1,
    version_output: 2,
};

var palettes = require('users/mapbiomas/modules:Palettes.js');

// Nombres de bandas
var bandNames = ee.List(
    years.map(function(year){
        return 'classification_' + String(year);
    })
);

// Procesamiento por región
for(var rc = 0; rc < listrc.length; rc++){

    var regionId = listrc[rc][0];
    var pais     = listrc[rc][1];

    print('Procesando región:', regionId);

    // Cargar región
    var region = ee.FeatureCollection(Bounds)
        .filterMetadata('ord', 'equals', regionId);

    var regionRaster = region.reduceToImage({
        properties: ['ord'],
        reducer: ee.Reducer.first()
    }).gt(0).selfMask();

    // Cargar colección de clasificaciones para esta región
    var Clasificacion_WET = ee.ImageCollection(AssetGlacierWetClass)
        .filterMetadata('region', 'equals', regionId)
        .filterMetadata('version', 'equals', param.version_input);

    // PASO 1+2: Por cada año aplicar max y construir imagen multiband
    var Clasificacion = ee.Image(0).select([]);

    years.forEach(function(year){

        // max() fusiona múltiples sensores del mismo año
        var GlacierYear = Clasificacion_WET
            .filterMetadata('year', 'equals', year)
            .max()
            .unmask(25)
            .updateMask(regionRaster);

        Clasificacion = Clasificacion.addBands(
            GlacierYear.rename('classification_' + year)
        );
    });

    // Limpiar píxeles con valor 0
    var classif = ee.Image();
    var bandnameReg = Clasificacion.bandNames();

    bandnameReg.getInfo().forEach(function(bandName){
        var imagey = Clasificacion.select(bandName);
        var band0 = imagey.updateMask(imagey.unmask().neq(27));
        classif = classif.addBands(band0.rename(bandName));
    });

    var image = classif.select(bandnameReg);

    // Verificar bandas existentes vs esperadas
    var bandsOccurrence = ee.Dictionary(
        bandNames.cat(image.bandNames()).reduce(ee.Reducer.frequencyHistogram())
    );

    var bandsDictionary = bandsOccurrence.map(function(key, value){
        return ee.Image(
            ee.Algorithms.If(
                ee.Number(value).eq(2),
                image.select([key]).byte(),
                ee.Image().rename([key]).byte().updateMask(image.select(0))
            )
        );
    });

    // Convertir diccionario a imagen multiband
    var imageAllBands = ee.Image(
        bandNames.iterate(
            function(band, image){
                return ee.Image(image).addBands(bandsDictionary.get(ee.String(band)));
            },
            ee.Image().select()
        )
    );

    // PASO 3: Exportar
    var imageName = pais + '-' + regionId + '-' + param.version_output;

    var imageExport = imageAllBands.select(bandNames)
        .set('code_region', regionId)
        .set('pais', pais)
        .set('version', param.version_output)
        .set('descripcion', 'max-wet')
        .set('paso', 'P03');

    Export.image.toAsset({
        image: imageExport.updateMask(regionRaster),
        description: imageName,
        assetId: OutputAsset + imageName,
        pyramidingPolicy: {'.default': 'mode'},
        region: region.geometry().bounds(),
        scale: 30,
        maxPixels: 1e13
    });

    // Visualización
    Map.addLayer(
        imageExport,
        {
            bands: ['classification_2023'],
            min: 0, max: 34,
            palette: palettes.get('classification2'),
            format: 'png'
        },
        'max-wet region-' + regionId, false
    );

    Map.addLayer(
        region.style({color: 'ff0000', fillColor: 'ff000000'}),
        {format: 'png'},
        'Region ' + regionId, false
    );
}


var glacier = ee.Image("projects/mapbiomas-peru/assets/LAND-COVER/COLLECTION4/GLACIER-WET/classification/GLACIER-WET-LX-1-2009-1")
Map.addLayer(glacier, {min:27, max:34});