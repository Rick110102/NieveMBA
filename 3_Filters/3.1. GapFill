// PROCESO DE MAX + GAP FILL - GLACIER WET

// Por cada región se carga la clasificación, se aplica max por año,
// Cumple dos objetivos
// se construye imagen multiband (1) y se aplica gap fill (2)

var listrc = [
              // [1, "PERU"],
              // [2, "PERU"],
              // [3, "PERU"],
              // [4, "PERU"],
              // [5, "PERU"],
              // [6, "PERU"],
              // [7, "PERU"],
              // [8, "PERU"],
              // [9, "PERU"],
              // [10, "PERU"],
              // [11, "PERU"],
              // [12, "PERU"],
              // [13, "PERU"],
              // [14, "PERU"],
              // [15, "PERU"],
              // [16, "PERU"],
              // [17, "PERU"],
              // [18, "PERU"],
              // [19, "PERU"],
              // [20, "PERU"],
              [21, "PERU"],
              [22, "PERU"],
              [23, "PERU"],
              [24, "PERU"],
              [25, "PERU"],
              [26, "PERU"],
              [27, "PERU"],
              [28, "PERU"],
              [29, "PERU"],
              [30, "PERU"],
              [31, "PERU"],
              [32, "PERU"],
              [33, "PERU"],
              [34, "PERU"],
              [35, "PERU"],
              [36, "PERU"],
              [37, "PERU"],
              [38, "PERU"],
              [39, "PERU"],
              [40, "PERU"],
              [41, "PERU"],
              [42, "PERU"],
              [43, "PERU"],
              [44, "PERU"],
              [45, "PERU"],
              [46, "PERU"],
              [47, "PERU"],
              [48, "PERU"],
            ];

// Diccionario de años
var years = [
    2000, 2001, 2002, 2003, 2004,
    2005, 2006, 2007, 2008, 2009,
    2010, 2011, 2012, 2013, 2014,
    2015, 2016, 2017, 2018, 2019,
    2020, 2021, 2022, 2023, 2024,
    2025
];

var AssetGlacierWetClass = 'projects/mapbiomas-peru/assets/LAND-COVER/COLLECTION4/GLACIER-WET/classification';
var Bounds = 'projects/ee-mapbiomasaguaperu/assets/RegionesGlaciaresWet';
var OutputAsset = 'projects/mapbiomas-peru/assets/LAND-COVER/COLLECTION4/GLACIER-WET/classification-ft-v2/';
// La version 1, fueron testeos

var param = {
    version_input: 1,
    version_output: 2,
    // Versiones de procesamiento, input y output, salida del asset
};

var palettes = require('users/mapbiomas/modules:Palettes.js');

// Nombres de bandas 
var bandNames = ee.List(
    years.map(function(year){
        return 'classification_' + String(year);
        // Genera una lista ['classification_2000', 'classification_2001', ..., 'classification_2025']
        // Una banda por año, todas dentro de una sola imagen multiband
    })
);

// Función gap fill - misma lógica del código base
// Se hacen dos pasadas, una hacia adelante y hacia atras, rellena cada dato faltante con el valor del año anterior resuelto
// La segunda pasada, rellena lo que la primera pasada no pudo completar.
var applyGapFill = function(image) {

    // Rellena hacia adelante t0 → tn
    var imageFilledt0tn = bandNames.slice(1)
        .iterate(
            function(bandName, previousImage) {
                var currentImage = image.select(ee.String(bandName));
                previousImage = ee.Image(previousImage);
                currentImage = currentImage.unmask(previousImage.select([0]));
                // Aquí ocurre el relleno, donde los píxeles sin dato, se rellenan con el valor de la imagen previa
                // 2001 con 2000 - 2002 con el resuelto del 2001 - 2003 con el resuelto del 2002
                return currentImage.addBands(previousImage);
            },
            ee.Image(image.select([bandNames.get(0)]))
        );

    imageFilledt0tn = ee.Image(imageFilledt0tn);

    // Rellena hacia atrás tn → t0
    var bandNamesReversed = bandNames.reverse();
    // Lógica similar a la anterior.
    var imageFilledtnt0 = bandNamesReversed.slice(1)
        .iterate(
            function(bandName, previousImage) {
                var currentImage = imageFilledt0tn.select(ee.String(bandName));
                // Trabajamos sobre el resultado del rellenado previo
                previousImage = ee.Image(previousImage);
                currentImage = currentImage.unmask(
                    previousImage.select(previousImage.bandNames().length().subtract(1)));
                return previousImage.addBands(currentImage);
            },
            ee.Image(imageFilledt0tn.select([bandNamesReversed.get(0)]))
        ); // Esta segunda pasada no sobreescribe los valores corregidos de la primera, solo actua sobre píxeles que siguen enmascarados

    imageFilledtnt0 = ee.Image(imageFilledtnt0).select(bandNames);

    return imageFilledtnt0;
};

// Procesamiento por región
for(var rc = 0; rc < listrc.length; rc++){

    var regionId  = listrc[rc][0];
    var pais      = listrc[rc][1];

    print('Procesando región:', regionId);

    // Cargar región
    var region = ee.FeatureCollection(Bounds)
        .filterMetadata('ord', 'equals', regionId);

    var regionRaster = region.reduceToImage({
        properties: ['ord'],
        reducer: ee.Reducer.first()
    }).gt(0).selfMask();

    // Cargar colección de clasificaciones para esta región
    var Clasificacion_WET = ee.ImageCollection(AssetGlacierWetClass)
        .filterMetadata('region', 'equals', regionId)
        .filterMetadata('version', 'equals', param.version_input);

    // PASO 1+2: Por cada año aplicar max y construir imagen multiband
    var Clasificacion = ee.Image(0).select([]);

    years.forEach(function(year){

        // max() fusiona múltiples sensores del mismo año
        var GlacierYear = Clasificacion_WET
            .filterMetadata('year', 'equals', year)
            .max() // Fusiona las imágenes en una sola, si hay más de un año clasificado
            .unmask(25) // Cualquier píxel sin clasificar, es no glaciar
            .updateMask(regionRaster); // Recorte al límite

        Clasificacion = Clasificacion.addBands(
            GlacierYear.rename('classification_' + year) // 
        );
    });

    // Limpiar píxeles con valor 0
    var classif = ee.Image();
    var bandnameReg = Clasificacion.bandNames();

    bandnameReg.getInfo().forEach(function(bandName){
        var imagey = Clasificacion.select(bandName);
        var band0 = imagey.updateMask(imagey.unmask().neq(27));
        classif = classif.addBands(band0.rename(bandName));
    });

    var image = classif.select(bandnameReg);

    // Verificar bandas existentes vs esperadas
    // Verificamos la presencia de las 26 bandas
    var bandsOccurrence = ee.Dictionary(
        bandNames.cat(image.bandNames()).reduce(ee.Reducer.frequencyHistogram())
                                        // Contamos cuantas veces aparece cada nombre en la lista
                                        // Si aparece dos veces es un año esperado
                                        // Si solo aparece una vez, no presente
    );

    var bandsDictionary = bandsOccurrence.map(function(key, value){
        return ee.Image(
            ee.Algorithms.If(
                ee.Number(value).eq(2),
                image.select([key]).byte(), // Si no se tienen un conteo de 2, se crea una banda enmascarada vacía
                ee.Image().rename([key]).byte().updateMask(image.select(0))
            ) // Buscamos siempre tener las 26 bandas, serán trabajadas con el gapfill---
        );
    });

    // Convertir diccionario a imagen multiband
    var imageAllBands = ee.Image(
        bandNames.iterate(
            function(band, image){
                return ee.Image(image).addBands(bandsDictionary.get(ee.String(band)));
            },
            ee.Image().select()
        )
    );

    // PASO 3: Aplicar gap fill
    var imageFilledtnt0 = applyGapFill(imageAllBands);

    // PASO 4: Exportar
    var imageName = pais + '-' + regionId + '-' + param.version_output;

    imageFilledtnt0 = imageFilledtnt0.select(bandNames) // Ordeb de bandas 2000 - 2025
        .set('code_region', regionId)
        .set('pais', pais)
        .set('version', param.version_output)
        .set('descripcion', 'gapfill-wet')
        .set('paso', 'P03');

    Export.image.toAsset({
        image: imageFilledtnt0.updateMask(regionRaster),
        description: imageName,
        assetId: OutputAsset + imageName,
        pyramidingPolicy: {'.default': 'mode'},
        region: region.geometry().bounds(),
        scale: 30,
        maxPixels: 1e13
    });

    // Visualización
    Map.addLayer(
        imageFilledtnt0,
        {
            bands: ['classification_2000'],
            min: 0, max: 34,
            palette: palettes.get('classification2'),
            format: 'png'
        },
        'gap fill region-' + regionId, false
    );

    Map.addLayer(
        region.style({color: 'ff0000', fillColor: 'ff000000'}),
        {format: 'png'},
        'Region ' + regionId, false
    );
}


var glacier = ee.Image("projects/mapbiomas-peru/assets/LAND-COVER/COLLECTION4/GLACIER-WET/classification/GLACIER-WET-LX-1-2000-1")
Map.addLayer(glacier, {min:27, max:34});