var AssetRegions = 'projects/ee-mapbiomasaguaperu/assets/RegionesGlaciaresWet';
var Class        = 'projects/mapbiomas-peru/assets/LAND-COVER/COLLECTION4/GLACIER-WET/classification-ft-v2';

var getImages    = require('users/mapbiomasaguaperu/GlaciaresWet2026:New_Collection/GetImages.js');
var smafractions = require('users/mapbiomasaguaperu/GlaciaresWet2026:New_Collection/Sma-fraction.js');

// ── VISUALIZACIONES ─────────────────────────────────────────────
var vis_mosaic = {
  bands: 'swir1_median_wet,nir_median_wet,red_median_wet',
  min: 300, max: 5000
};

var vis_class = {
  min: 0, max: 34,
  palette: ['black', 'white']
};

// ── DATOS BASE ───────────────────────────────────────────────────
var region = ee.FeatureCollection(AssetRegions)
  .filter(ee.Filter.eq('ord', regionGlacier));

var regionRaster = region.reduceToImage({
  properties: ['ord'],
  reducer: ee.Reducer.first()
}).gt(0).selfMask();

var classImg = ee.ImageCollection(Class)
  .filter(ee.Filter.eq('code_region', regionGlacier))
  .filter(ee.Filter.eq('version', versionInput));

// ── ALMACÉN DE REFERENCIAS ───────────────────────────────────────
var mosaicLayers = [];
var classLayers  = [];

// ── CREAR MAPAS Y SINCRONIZAR ────────────────────────────────────
var maps = YearsSensors.map(function() { return ui.Map(); });
ui.Map.Linker(maps, 'change-bounds');

// ── CAPAS POR PANEL ──────────────────────────────────────────────
YearsSensors.forEach(function(yearsensor, i) {
  var year   = yearsensor[0];
  var sensor = yearsensor[1];
  var cloud  = yearsensor[2];
  var m      = maps[i];

  var param = {
    't0':           year + '-01-01',
    't1':           year + '-12-31',
    'satellite':    sensor,
    'cloud_cover':  cloud,
    'pais':         'PERU',
    'regionMosaic': regionGlacier,
    'shadowSum':    3500
  };

  var ImagesYear = getImages.getImages(param, [], region);
  var Mosaic = ImagesYear[0].updateMask(regionRaster);
  Mosaic = Mosaic.updateMask(Mosaic.select('blue_median').gte(0));
  Mosaic = smafractions.getFractions(Mosaic);

  var classYear = classImg.select(['classification_' + year]);

  // ── Crear layers con referencia guardada ──────────────────────
  var mosaicLayer = ui.Map.Layer(
    Mosaic, vis_mosaic,
    'Mosaico WET ' + year + ' (' + sensor.toUpperCase() + ')',
    true, 1.0
  );

  var classLayer = ui.Map.Layer(
    classYear, vis_class,
    'Estimación Snow ' + year,
    true, 1.0
  );

  var regionLayer = ui.Map.Layer(
    region.style({ fillColor: '#00000000', color: 'FFA500', width: 2 }),
    {}, 'Región ' + regionGlacier, true
  );

  m.layers().add(mosaicLayer);
  m.layers().add(classLayer);
  m.layers().add(regionLayer);

  // Guardar referencias para el panel de control
  mosaicLayers.push(mosaicLayer);
  classLayers.push(classLayer);

  // Etiqueta
  m.add(ui.Label(year + ' · ' + sensor.toUpperCase(), {
    position:        'top-left',
    fontWeight:      'bold',
    fontSize:        '20px',
    color:           'white',
    backgroundColor: '#00000099',
    padding:         '4px 10px',
    margin:          '0'
  }));

  m.setControlVisibility({
    mapTypeControl:    false,
    fullscreenControl: false,
    zoomControl:       true,
    scaleControl:      true,
    layerList:         true
  });

  m.centerObject(region, 8);
});

