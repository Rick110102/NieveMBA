/**
 * persistence_test
 * Script de prueba para el mosaico de persistencia
 * Año de prueba: 2023 con L8
 */

var AssetRegions = 'projects/ee-mapbiomasaguaperu/assets/RegionesGlaciaresWet';
var OutputAssetFreq = 'projects/mapbiomas-peru/assets/LAND-COVER/COLLECTION4/GLACIER-WET/persistence-frequency/';
var OutputAssetClass = 'projects/mapbiomas-peru/assets/LAND-COVER/COLLECTION4/GLACIER-WET/persistence-classification/';

var persistence = require('users/mapbiomasaguaperu/GlaciaresWet2026:2_classification/persistence');
var palettes = require('users/mapbiomas/modules:Palettes.js');
var dem = ee.Image("USGS/SRTMGL1_003");
var slope = ee.Terrain.slope(dem).rename('slope');

// Parámetros de prueba
var params = {
    'regionGlacier': 22,        // región de prueba
    'year': 2023,              // año de prueba
    'satellite': 'l8',         // sensor
    'cloudCover': 70,
    'ndsiThreshold': 140, 
    'snowThreshold': 20, 
    'persistThreshold': 50,    // ≥ 50% de imágenes
    'minObservations': 5,      // mínimo 5 obs válidas
    'exportar': true,
    'version': 1
};

// Cargar región
var region = ee.FeatureCollection(AssetRegions)
    .filterMetadata('ord', 'equals', params.regionGlacier);

var regionRaster = region.reduceToImage({
    properties: ['ord'],
    reducer: ee.Reducer.first()
}).gt(0).selfMask();

Map.addLayer(
    region.style({fillColor: '000000', color: '00000000'}),
    {}, 'Background'
);

// Crear mosaico de persistencia
var result = persistence.getPersistenceMosaic({
    'year': params.year,
    'satellite': params.satellite,
    'cloudCover': params.cloudCover,
    'ndsiThreshold': params.ndsiThreshold,
    'persistThreshold': params.persistThreshold,
    'minObservations': params.minObservations,
    'geometry': region.geometry()
});

// Resultados
var frequencyMosaic          = result.frequencyMosaic.updateMask(regionRaster);
var persistenceClassification = result.persistenceClassification.updateMask(regionRaster);
var totalObs                 = result.totalObs.updateMask(regionRaster);
var snowFrequency            = result.snowFrequency.updateMask(regionRaster);

print('Frecuencia mosaico:', frequencyMosaic.bandNames());
print('Clasificación:', persistenceClassification.bandNames());

// Visualización
Map.addLayer(totalObs, {
    min: 0, max: 40,
    palette: ['white', 'blue']
}, 'Total observaciones', false);

Map.addLayer(snowFrequency, {
    min: 0, max: 100,
    palette: ['#00007F','#002AFF','#00D4FF','#7FFF7F','#FFD400','#FF2A00','#7F0000']
}, 'Frecuencia nieve %', false);

Map.addLayer(
    persistenceClassification.updateMask(persistenceClassification.eq(34)),
    {palette: 'ff0000'},
    'Nieve persistente (≥50%)', false
);

Map.addLayer(
    persistenceClassification.updateMask(persistenceClassification.eq(33)),
    {palette: 'ffaa00'},
    'Nieve estacional (<50%)', false
);

Map.addLayer(
    region.style({fillColor: '#ff000000', color: 'f59e42'}),
    {}, 'Region ' + params.regionGlacier, false
);

// Exportar
var imageName = 'PERSIST-' + params.satellite.toUpperCase() +
                '-' + params.regionGlacier +
                '-' + params.year +
                '-' + params.version;

if(params.exportar) {

    // Asset 1 - Mosaico de frecuencia
    Export.image.toAsset({
        image: frequencyMosaic,
        description: 'FREQ-' + imageName,
        assetId: OutputAssetFreq + 'FREQ-' + imageName,
        pyramidingPolicy: {'.default': 'mean'},
        region: region.geometry().bounds(),
        scale: 30,
        maxPixels: 1e13
    });

    // Asset 2 - Clasificación de persistencia
    Export.image.toAsset({
        image: persistenceClassification.toInt8(),
        description: 'CLASS-' + imageName,
        assetId: OutputAssetClass + 'CLASS-' + imageName,
        pyramidingPolicy: {'.default': 'mode'},
        region: region.geometry().bounds(),
        scale: 30,
        maxPixels: 1e13
    });
}

var SnowMax = ee.Image("projects/mapbiomas-peru/assets/LAND-COVER/COLLECTION4/GLACIER-WET/integration/PERU-SNOW-2023-1");
Map.addLayer(SnowMax, {palette:["blue"]});