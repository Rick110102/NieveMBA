// ----------------------------------------------------------
// Función: área nieve en Ha por región y año
// ----------------------------------------------------------
var calcNieveHa = function(snowImage, regionGeometry, regionId, year) {

  var mask = snowImage.eq(CLASE_NIEVE);

  var areaHa = mask
    .multiply(ee.Image.pixelArea())
    .divide(10000)
    .rename('area_ha');

  var result = areaHa.reduceRegion({
    reducer:    ee.Reducer.sum(),
    geometry:   regionGeometry,
    scale:      30,
    maxPixels:  1e13,
    bestEffort: true
  });

  // Redondear a 2 decimales
  var areaFinal = ee.Number(result.get('area_ha'))
                    .multiply(100).round().divide(100);

  return ee.Feature(null, {
    'year':        year,
    'region_id':   regionId,
    // 'region_name': DEPT_NAMES[regionId] || ('Departamento ' + regionId),
    'area_ha':     areaFinal
  });
};

// ----------------------------------------------------------
// Loop principal: años × departamentos
// ----------------------------------------------------------
var statsCollection = ee.FeatureCollection([]);

for (var year = startYear; year <= endYear; year++) {

  var snowImage = ee.Image(
    'projects/mapbiomas-peru/assets/LAND-COVER/COLLECTION4/GLACIER-WET/' +
    'integration/PERU-SNOW-' + year + '-2'
  );

  DEPT_IDS.forEach(function(regionId) {
    var region     = allRegions.filter(ee.Filter.eq('feature_id', regionId));
    var regionGeom = region.geometry();
    var stats      = calcNieveHa(snowImage, regionGeom, regionId, year);

    statsCollection = statsCollection.merge(ee.FeatureCollection([stats]));
  });
}

// ----------------------------------------------------------
// Export a Drive
// ----------------------------------------------------------
Export.table.toDrive({
  folder:      'ESTADÍSTICA-XDEPARTAMENTO-SNOW-2025',
  collection:  statsCollection.sort('year'),
  description: 'Nieve_Area_Por_Departamento_Ha_V2',
  fileFormat:  'CSV',
  // selectors:   ['year', 'region_id', 'region_name', 'area_ha']
});

