var years = [
    2000, 2001, 2002, 2003, 2004,
    2005, 2006, 2007, 2008, 2009,
    2010, 2011, 2012, 2013, 2014,
    2015, 2016, 2017, 2018, 2019,
    2020, 2021, 2022, 2023, 2024,
    2025
];
// projects/mapbiomas-peru/assets/LAND-COVER/COLLECTION4/GLACIER-WET/classification-ft-v2/PERU-1-2
var AssetGlacierWetClass = 'projects/mapbiomas-peru/assets/LAND-COVER/COLLECTION4/GLACIER-WET/classification';
var Bounds = 'projects/ee-mapbiomasaguaperu/assets/RegionesGlaciaresWet';
var InputAsset = 'projects/mapbiomas-peru/assets/LAND-COVER/COLLECTION4/GLACIER-WET/classification-ft-v2';
var OutputAsset = 'projects/mapbiomas-peru/assets/LAND-COVER/COLLECTION4/GLACIER-WET/classification-ft-v2/';
var lakes = 'projects/mapbiomas-peru/assets/WATER/COLLECTION-3/BODY-REMAP/SNIC_OBJ/obj_acumulado';
  // Importamos la capa de agua de MapBiomasAgua para enmascarar las lagunas o cuerpos de agua mal clasificados
// La version 1, fueron testeos

var palettes = require('users/mapbiomas/modules:Palettes.js');

// ── Visualización ─────────────────────────────────────────────────────────────
var vis = {
  min:     0,
  max:     62,
  palette: palettes.get('classification8')
};

// ── Nombres de bandas ─────────────────────────────────────────────────────────
var bandNames = ee.List(
    years.map(function(year){
        return 'classification_' + String(year);
    })
);

// ── Rasterizar lagunas (FeatureCollection → Image binaria, fuera del loop) ────
var lagunaImage = ee.Image(0).paint(ee.FeatureCollection(lakes), 1);

// ── LOOP PRINCIPAL ────────────────────────────────────────────────────────────
for (var rc = 0; rc < listrc.length; rc++) {

  var param = {
    code_region:    listrc[rc][0],
    pais:           listrc[rc][1],
    version_input:  2,   // ← versión de entrada (imagen multibanda PERU-X-2)
    version_output: 3,   // ← versión de salida tras enmascaramiento
    exportOpcion: {
      DriveFolder:         'DRIVE-EXPORT',
      exportClasifToDrive: false,
    }
  };

  print('Procesando región:', param.code_region);

  var prefixo_out = param.pais + '-' + param.code_region + '-' + param.version_output;

  // ── Geometría de la región ──────────────────────────────────────────────────
  var regions    = ee.FeatureCollection(Bounds)
                     .filterMetadata('ord', 'equals', param.code_region);
  var regionGeom = regions.geometry();

  // ── Cargar imagen multibanda (todas las bandas de una vez) ──────────────────
  var class4 = ee.ImageCollection(InputAsset)
                 .filterMetadata('code_region', 'equals', param.code_region)
                 .filterMetadata('version',     'equals', param.version_input)
                 .first()
                 .select(bandNames);

  // ── Laguna rasterizada recortada a la región ────────────────────────────────
  var lagunaClipped = lagunaImage.clip(regionGeom);

  // ── Enmascaramiento de lagunas por año ──────────────────────────────────────
  var class4_masked = ee.ImageCollection(
    years.map(function(yr){
      var bandName  = 'classification_' + yr;
      var classBand = class4.select([bandName]);

      // Píxeles que son laguna (1) Y glaciar (34) → reclasificar a 25
      // Condicional "and" -> v & v = v, debe ser laguna y nieve para enmascarar como no nieve
      var mascara = lagunaClipped.gt(0).and(classBand.eq(34));

      return classBand.where(mascara, 25).rename(bandName);
    })
  ).toBands().rename(bandNames);

  // ── Visualización ───────────────────────────────────────────────────────────
  years.forEach(function(yr) {
    var bandName = 'classification_' + yr;

    Map.addLayer(
      class4.select(bandName).clip(regionGeom),
      vis,
      'Original v' + param.version_input + ' - R' + param.code_region + ' - ' + yr,
      false
    );

    Map.addLayer(
      class4_masked.select(bandName).clip(regionGeom),
      vis,
      'Enmascarado v' + param.version_output + ' - R' + param.code_region + ' - ' + yr,
      false
    );
  });

  Map.centerObject(regionGeom, 9);

  // ── Exportar a Asset ────────────────────────────────────────────────────────
  Export.image.toAsset({
    image:            class4_masked.clip(regionGeom).toUint8().
          set({
            'code_region': param.code_region,
            'pais':        param.pais,
            'version':     param.version_output,   
            'paso':        'P03',                  
            'descripcion': 'unmask-lakes', 
          }),
    description:      prefixo_out,
    assetId:          OutputAsset + prefixo_out,
    pyramidingPolicy: { '.default': 'mode' },
    region:           regionGeom,
    scale:            30,
    maxPixels:        1e13
  });

 
  // if (param.exportOpcion.exportClasifToDrive) {
