// Crearemos un mosaico con las imágenes clasificadas de Wet + Dry
/* Justificación:Existen vacíos de información en los mosaicos de temporada húmeda, pero estos vacíos
                  tienen información de clasificación en glaciares de percentile 25, entonces,
                  es de suponer que si hay nieve presente en temporadas con poca cobertura de nieve
                  la permanencia también debe estar en la temporada húmeda con mucha más cobertura de nieve
*/
// var Class = ee.Image("projects/mapbiomas-peru/assets/LAND-COVER/COLLECTION4/GLACIER/integration-v2/PERU-1985-1");
// print(Class)

var biomas = ee.FeatureCollection("projects/mapbiomas-peru/assets/LAND-COVER/AUXILIARY-DATA/VECTOR/BIOMAS")
            .filter(ee.Filter.eq("LEVEL_2", "Andes"));
// var ClassW = ee.Image("projects/mapbiomas-peru/assets/LAND-COVER/COLLECTION4/GLACIER-WET/integration/PERU-2000-1");
// print(ClassW)
// Función para crear el mosaico
function mosaicSnow(año){
  var ClassDry = ee.Image("projects/mapbiomas-peru/assets/LAND-COVER/COLLECTION4/GLACIER/integration-v2/PERU-" + año + "-1");
  var ClassWet = ee.Image("projects/mapbiomas-peru/assets/LAND-COVER/COLLECTION4/GLACIER-WET/integration/PERU-" + año + "-4");
      /*Recordar version 1 = Sin filtros altitudinales ni de bioma
                  version 2 = Con filtro altitudinal -> Delimita presencia de nieve en base a la altitud mínima de nieve registrada
                  version 3 = Con filtro de bioma -> Delimitada a la región Andes
                  version 4 = Contempla los datos con filtros aplicados, de persistencia y de corrección para años vacíos, sin filtros de bioma o altitud
      */
                  
    var mosaico = ee.ImageCollection([ClassDry, ClassWet]).mosaic()
                  .set({
                    "year": año,
                    "collection": "4",
                    "version": "2", // Versión 2, por la presencia de filtros y demás, comparar con la versión 1, debe existir gran diferencia.
                    "country": "PERU",
                    "Source": "IBC",
                    "Theme": "Snow",
                  });
  
  Map.addLayer(ClassDry, {palette:["#F54927"], min:0, max:34}, "Glaciar Dy " + año, false);
  Map.addLayer(ClassWet, {palette:["#07079C"], min:0, max:34}, "Glaciar Wet " + año, false);
  Map.addLayer(mosaico, {palette:["#05701B"], min:0, max:34}, "Mosaico Snow  " + año, false);
  return mosaico;
}

var años = [2000, 2001, 2002, 2003, 2004, 2005, 2006, 2007, 2008, 2009, 2010,
            2011, 2012, 2013, 2014, 2015, 2016, 2017, 2018, 2019, 2020, 2021,
            2022, 2023, 2024, 2025];

años.forEach(function(año){
  var imgSnow = mosaicSnow(año);
  
  Export.image.toAsset({
    image: imgSnow,
    description: "PERU-SNOW-" + año,
    assetId: "projects/mapbiomas-peru/assets/LAND-COVER/COLLECTION4/GLACIER-WET/integration/PERU-SNOW-" + año + "-2" ,
    scale: 30,
    region: biomas.geometry().bounds(),
    maxPixels: 1e13
  });
});

