for(var rc = 0; rc < listrc.length; rc++){
  var param = { 
      regionGlacier: listrc[rc][0],
      pais: listrc[rc][1], 
      year: 2002,
      version_input: 4,
      version_output: 5,
      consistencyThreshold: 0.96  // ← umbral modificable
  };
  
  print(param.regionGlacier);
  
  var dirinput = 'projects/mapbiomas-peru/assets/LAND-COVER/COLLECTION4/GLACIER-WET/classification-ft-v2';
  var dirout   = 'projects/mapbiomas-peru/assets/LAND-COVER/COLLECTION4/GLACIER-WET/classification-ft-v2/';
  
  var AssetRegions = 'projects/ee-mapbiomasaguaperu/assets/RegionesGlaciaresWet';
  
  var AssetRegionsRaster = ee.Image(0).paint(ee.FeatureCollection(AssetRegions), 1);
  
  var prefixo_out = param.pais + '-' + param.regionGlacier + '-' + param.version_output;
  
  var region = ee.FeatureCollection(AssetRegions)
               .filterMetadata('ord', 'equals', param.regionGlacier);
              
  var regionGeom = region.geometry();
  var regionRaster = AssetRegionsRaster.clip(regionGeom);
  
  var palettes = require('users/mapbiomas/modules:Palettes.js');
  var vis = {
      'min': 0,
      'max': 34,
      'palette': palettes.get('classification2')
  };
  
  var class5FT = ee.ImageCollection(dirinput)
                   .filterMetadata('code_region', 'equals', param.regionGlacier)
                   .filterMetadata('version', 'equals', param.version_input)
                   .first();
  print('Input clasificacion:', class5FT);
  
  var years = [
      2000, 2001, 2002, 2003, 2004,
      2005, 2006, 2007, 2008, 2009,
      2010, 2011, 2012, 2013, 2014,
      2015, 2016, 2017, 2018, 2019,
      2020, 2021, 2022, 2023, 2024,
      2025
  ];    
      
  var bandNames = ee.List(
      years.map(function(year){
          return 'classification_' + String(year);
      })
  );

  // ============================================================
  // FILTRO DE CONSISTENCIA - UMBRAL 90%
  // Si un píxel está mapeado como nieve (34) en ≥ 90% de los
  // años de la serie temporal, se fuerza clase 34 en TODOS
  // los años, llenando vacíos por continuidad glaciar
  // ============================================================

  // PASO 1 - Contar cuántos años el píxel fue clase 34
  var snowPresence = bandNames.iterate(
      function(bandName, acc){
          bandName = ee.String(bandName);
          var isSnow = class5FT.select(bandName).eq(34);
          return ee.Image(acc).add(isSnow);
      },
      ee.Image(0)
  );
  snowPresence = ee.Image(snowPresence).rename('snow_count');

  // PASO 2 - Total de años con datos válidos por píxel
  var totalYears = bandNames.iterate(
      function(bandName, acc){
          bandName = ee.String(bandName);
          // Cuenta años con dato válido (34 o 25, no enmascarado)
          var hasData = class5FT.select(bandName).mask();
          return ee.Image(acc).add(hasData);
      },
      ee.Image(0)
  );
  totalYears = ee.Image(totalYears).rename('total_years');

  // PASO 3 - Calcular frecuencia de presencia como nieve
  var snowFrequency = snowPresence
      .divide(totalYears)
      .rename('snow_frequency');

  print('Snow frequency stats:', snowFrequency.reduceRegion({
      reducer: ee.Reducer.minMax(),
      geometry: regionGeom,
      scale: 30,
      maxPixels: 1e9
  }));

  // PASO 4 - Máscara de píxeles consistentes (≥ 90%)
  var consistentPixels = snowFrequency
      .gte(param.consistencyThreshold)
      .rename('consistent_pixels');

  // PASO 5 - Aplicar filtro de consistencia a cada banda
  // Si el píxel es consistente → forzar 34 en todos los años
  // Si no es consistente → dejar sin modificación
  var imageConsistency = ee.Image(0).select([]);

  years.forEach(function(year){
      var bandName = 'classification_' + year;
      var originalBand = class5FT.select(bandName);

      // Forzar 34 donde píxel es consistente
      var filteredBand = originalBand
          .where(consistentPixels.eq(1), 34)
          .rename(bandName);

      imageConsistency = imageConsistency.addBands(filteredBand);
  });

  // ============================================================
  // VISUALIZACIÓN
  // ============================================================
  var yearsToShow = years;
  
  Map.addLayer(snowPresence.clip(regionGeom), {
      min: 0, max: 26,
      palette: ['white','#00D4FF','#002AFF','#7F0000']
  }, 'Snow count region-' + param.regionGlacier, false);

  Map.addLayer(snowFrequency.clip(regionGeom), {
      min: 0, max: 1,
      palette: ['white','#00D4FF','#002AFF','#7F0000']
  }, 'Snow frequency region-' + param.regionGlacier, false);

  Map.addLayer(consistentPixels.clip(regionGeom).selfMask(), {
      palette: 'ff0000'
  }, 'Consistent pixels (≥90%) region-' + param.regionGlacier, false);
  
  yearsToShow.forEach(function(y){
      var bandName = 'classification_' + y;

      Map.addLayer(class5FT.select(bandName).clip(regionGeom), {
          min: 0, max: 34,
          palette: palettes.get('classification2')
      }, 'Original v' + param.version_input + ' - ' + y, false);

      Map.addLayer(imageConsistency.select(bandName).clip(regionGeom), {
          min: 0, max: 34,
          palette: palettes.get('classification2')
      }, 'Consistencia v' + param.version_output + ' - ' + y, false);
  });
  
  // Map.addLayer(class5FT, {
  //     'bands': ['classification_' + param.year],
  //     'min': 0, 'max': 34,
  //     'palette': palettes.get('classification2')
  // }, 'Original region-' + param.regionGlacier, false);

  // Map.addLayer(imageConsistency, {
  //     'bands': ['classification_' + param.year],
  //     'min': 0, 'max': 34,
  //     'palette': palettes.get('classification2')
  // }, 'Consistency filter region-' + param.regionGlacier, false);

  Map.addLayer(
      region.style({color: 'ff0000', fillColor: 'ff000000'}),
      {}, 'Region ' + param.regionGlacier, false
  );

  // ============================================================
  // EXPORTAR
  // ============================================================

  var imageExport = imageConsistency
      .select(bandNames)
      .set('code_region', param.regionGlacier)
      .set('pais', param.pais)
      .set('version', param.version_output)
      .set('descripcion', 'Filtro de Consistencia')
      .set('paso', 'P05')
      .set('consistency_threshold', param.consistencyThreshold);

  Export.image.toAsset({
      image: imageExport.updateMask(regionRaster),
      description: prefixo_out,
      assetId: dirout + prefixo_out,
      pyramidingPolicy: {'.default': 'mode'},
      region: regionGeom.bounds(),
      scale: 30,
      maxPixels: 1e13
  });
}


