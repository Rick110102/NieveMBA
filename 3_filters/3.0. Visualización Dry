// ── VISUALIZACIONES ─────────────────────────────────────────────
var vis_mosaic = {
  bands: 'swir1_median_dry,nir_median_dry,red_median_dry',
  min: 300, max: 5000
};

var vis_class = {
  min: 0, max: 34,
  palette: ['black', 'white']
};

// ── DATOS BASE ───────────────────────────────────────────────────
var region = ee.FeatureCollection(AssetRegions)
  .filter(ee.Filter.eq('id_regionC', regionGlacier))
  .map(function(feat){
    return feat.buffer(50000);
  });

var regionRaster = region.reduceToImage({
  properties: ['id_regionC'],
  reducer: ee.Reducer.first()
}).gt(0).selfMask();

var classImg = ee.ImageCollection(Class)
  .filter(ee.Filter.eq('code_region', regionGlacier))
  .filter(ee.Filter.eq('version', versionInput));
  
var classImg35 = ee.ImageCollection(C3)
  .filter(ee.Filter.eq('code_region', regionGlacier))
  .filter(ee.Filter.eq('version', versionInput35));
  

// ── ALMACÉN DE REFERENCIAS ───────────────────────────────────────
