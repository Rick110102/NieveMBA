var n    = maps.length;
var cols = 2;
var rows = [];

var panelStyle = {
  stretch: 'both',
  height:  (100 / Math.ceil(n / cols)) + '%',
  margin:  '0px',
  padding: '0px'
};

for (var r = 0; r < Math.ceil(n / cols); r++) {
  var rowMaps = [];
  for (var c = 0; c < cols; c++) {
    var idx = r * cols + c;
    if (idx < n) rowMaps.push(maps[idx]);
  }
  rows.push(ui.Panel(rowMaps, ui.Panel.Layout.flow('horizontal'), panelStyle));
}

var mainPanel = ui.Panel(
  rows,
  ui.Panel.Layout.flow('vertical'),
  { stretch: 'both', margin: '0px', padding: '0px' }
);

ui.root.clear();
ui.root.add(mainPanel);

