// ── DEM: NASADEM (reemplaza SRTM, mejor cobertura en Andes) ──────────────────
// Alternativa: ee.Image('USGS/SRTMGL1_003').select('elevation')
var dem = ee.Image('NASA/NASADEM_HGT/001')
    .select('elevation')
    .rename('elevation');
    
// También calculamos pendiente por si es útil para futuras máscaras
var slope = ee.Terrain.slope(dem).rename('slope');

