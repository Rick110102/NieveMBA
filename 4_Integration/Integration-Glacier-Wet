// ── Integración ───────────────────────────────────────────────────────────────
var collectionsByRegion = codesAndVersions.map(function(codeAndVersion) {
    var code    = codeAndVersion[0];
    var version = codeAndVersion[1];

    var regionMask = regionsRaster.eq(code);

    var images = ee.ImageCollection(dirinputClassFil)
        .filterMetadata('code_region', 'equals', code)
        .filterMetadata('version', 'equals', version)
        .map(function(image) {
            return image.updateMask(regionMask);
        })
        .mosaic()
        .updateMask(
            ee.ImageCollection(dirinputClassFil)
                .filterMetadata('code_region', 'equals', code)
                .filterMetadata('version', 'equals', version)
                .mosaic()
                .eq(34)
        );

    return images.byte();
});

var allRegionsClassification = ee.ImageCollection.fromImages(ee.List(collectionsByRegion));
var integracion_v0 = allRegionsClassification.mosaic();

// -- Filtro altitudinal: Solo trabajamos con píxeles sobre los 3400 m.s.n.m
// Justificación: Bonshoms et. al (2018, SENAMHI), donde se establece el rango altitudinal de 3400
// Como cota mínima abosulta de registros de eventos de nieve en 10 años de estudio
// Todo píxel clasificado sobre esta cota, será considerada como nieve y todo píxel debajo de esta cota
// SERÁ ENMASCARADA...

print('integracion_v0 bandas:', integracion_v0.bandNames());

var elevMask = dem.gte(3400);
var integracion_3400 = integracion_v0.updateMask(elevMask);

print("Bandas con información sobre los 3400:", integracion_3400.bandNames());

// ── Visualización del resultado integrado ─────────────────────────────────────
Map.addLayer(regionClas, {}, 'Regiones Glaciares', false);

for (var y = param.years_start; y <= param.years_end; y++) {
    Map.addLayer(
        integracion_v0,
        { bands: 'classification_' + y, min: 0, max: 34, palette: ["red"]},
        'classification_' + y,
        false);
    Map.addLayer(
        integracion_3400,
        { bands: 'classification_' + y, min: 0, max: 34, palette: ["green"]},
        'classification_' + y + "> 3400",
        false );
}

// ── Exportación por año ───────────────────────────────────────────────────────
for (var year = param.years_start; year <= param.years_end; year++) {
    var prefixo_out = param.pais + '-' + year + '-' + param.version_output;

    var integracionYear = integracion_3400
        .select('classification_' + year)
        .rename('classification')
        .set('country',    param.pais)
        .set('theme',      'GLACIER')
        .set('year',       year)
        .set('version',    param.version_output)
        .set('collection', '5.0')
        .set('source',     param.source);

    Export.image.toAsset({
        image:            integracionYear,
        description:      prefixo_out,
        assetId:          dirout + prefixo_out,
        pyramidingPolicy: { '.default': 'mode' },
        region:           country.geometry().bounds(),
        scale:            30,
        maxPixels:        1e13,
    });
}


